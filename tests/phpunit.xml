<phpunit
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://schema.phpunit.de/4.1/phpunit.xsd"
        bootstrap="phpunitbootstrap.php">
    <testsuites>
        <testsuite name="Forward">
            <directory>unit</directory>
        </testsuite>
        <testsuite name="Light">
            <directory>../src/Light/Tests</directory>
        </testsuite>
    </testsuites>

    <filter>
        <whitelist>
            <directory suffix=".php">../src/</directory>
            <exclude>
                <directory suffix=".php">../src/Light/External/</directory>
                <directory suffix=".php">../src/Light/Codeception/</directory>
                <directory suffix=".php">../src/Light/Tests/</directory>
            </exclude>
        </whitelist>
    </filter>
</phpunit>
{
  "compilerOptions": {
    "jsx": "react",
    "target": "es5",
    "module": "es2015",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "removeComments": false,
    "preserveConstEnums": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "listFiles": true,
    "pretty": true,
    "allowJs": false,
    "strictNullChecks": true,
    "noUnusedParameters":true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "newLine": "LF"
  },
  "include": ["src/**/*"]
}

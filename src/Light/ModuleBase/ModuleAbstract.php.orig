    {
        $print['name'] = $name;
        $print['additionalParams'] = $additionalParams;

        if ($withStamp) {
            $print['name'] = $name . ' With Stamp';
            $print['additionalParams']['Stamp'] = 1;
            $this->_documentPrintTemplates[] = $print;

            $print['name'] = $name;
            $print['additionalParams']['Stamp'] = 0;
            $this->_documentPrintTemplates[] = $print;
        } else {
            $this->_documentPrintTemplates[] = $print;
        }
    }

    protected function parseRequestParams()
    {

        $params = [
            'char' => [
                'ids', //id coma separated
                'Lang', // doc Language En|Ru
                'Module', // module if linked other module
                'PDFName', // Doc Name if not set generates from ObjectName, ObjectId, Lang, Stamp
                'PDFTemplate', // path to css file
                'wordFunc', // method to save word
                'printFunc', // method to get Html
                'ObjectName'
            ],
            'int' => [
                'Stamp', // w\wo stamp 1:0
                'ObjectID' // ID if linked other module
            ],
            'checkbox' => [
                'saveWord', // 1:0
                'savePDF', // 1:0
            ],
            'array' => [
                'Path', // path too save recieves multiple values if not set generated from Module, ObjectId
                'extraParams' //if some extra values needed to passthrough into function "key=param,key1=param1"
            ]
        ];

        $requestParams = [];

        foreach ($params as $type => $values) {
            foreach ($values as $param) {
                if ($type == 'char') {
                    $requestParams[$param] = (isset($_REQUEST[$param])) ? $_REQUEST[$param] : null;
                }
                if ($type == 'int') {
                    $requestParams[$param] = (isset($_REQUEST[$param])) ? (int)$_REQUEST[$param] : 0;
                }
                if ($type == 'array') {
                    if (isset($_REQUEST[$param])) {
                        $arrayParam = explode(',', $_REQUEST[$param]);
                        if (strpos($arrayParam[0], '=') !== false) {
                            foreach ($arrayParam as $extraParam) {
                                if (strpos($extraParam, '=') !== false) {
                                    $array = explode('=', $extraParam);
                                    $requestParams[$param][$array[0]] = $array[1];
                                }
                            }
                        } else {
                            $requestParams[$param] = $arrayParam;
                        }
                    } else {
                        $requestParams[$param] = null;
                    }
                }
                if ($type == 'checkbox') {
                    if (isset($_REQUEST[$param])) {
                        $requestParams[$param] = $_REQUEST[$param] == 'on' ? 1 : 0;
                    } else {
                        $requestParams[$param] = 0;
                    }
                }
            }
        }

        //TODO временное решение, потом нужно переделать
        $requestParams['savePDF'] = 1;

        return $requestParams;
    }

    /**
     * Этот метод вызывает ф-ии печати из подзапроса
     */
    public function proceedDocumentPrint()
    {
        $requestParams = $this->parseRequestParams();

        if ($requestParams['ids'] != null) {
            //Тут массовая печать, этим занимается отдельный метод
            $this->proceedMassactionPrint($requestParams);
        } else {
            if ($this->_obj->getId() == null) {
                //null может возникнуть когда приходим на proceedDocumentPrint из massaction. В massaction используется loadurlparams
                //если пользователь сделает refresh таблицы, то loadurlparams пусто, таким образом ids тоже пусто и алгоритм попадает сюда
                //но конкретный $this->_obj->getId() тоже не задан!
                //это можно убрать, когда loadurlparams станет умным
                $this->redirectToList();
            }
            //Тут обычная печать
            //Метод для печати может быть задан вручную через additionalParams[printFunc] внутри addDocumentPrint()
            $html = '';
            $method = 'proceed' . $requestParams['printFunc'];

            if ($requestParams['printFunc'] != null) {
                if (!method_exists($this, $method)) {
                    $this->abortView(405, 'Method "' . $method . '" doesn exist');
                } else {
                    $html = call_user_func([$this, $method], $requestParams);
                }
            } else {
                //Если printFunc не был задан попробуем вызвать стандартный метод
                $html = $this->proceedPrint($requestParams);
            }

            //Если все прошло как надо мы получаем html и думаем что делать дальше

            if ($html != '') {
                $finalHtml = Template::parseTpl(
                    $this->_globalTemplate,
                    [
                        'title' => $this->_textObjectName . ' ' . $this->_obj->getId(),
                        'body' => $html,
                        'css' => $requestParams['PDFTemplate']
                    ]
                );
                //Сохранение документа в PDF
                if ($requestParams['savePDF'] == 1 && $requestParams['PDFTemplate'] != null && $this->_folders) {
                    $this->proceedSavePDF($finalHtml, $this->getPDFParams($requestParams));
                }

                //Сохранение документа в Word, при условии что есть функция для этого
                if ($requestParams['saveWord'] != 0 && $this->_folders) {
                    $this->proceedSaveDocumentWord($finalHtml);
                }

                print $finalHtml;
                ApplicationAbstract::terminate();
            } else {
                $this->abortView(405, 'Was no html to view');
            }
        }
    }

    protected function proceedMassactionPrint($params)
    {
        if ($params['ids'] != null) {
            $ids = explode(',', $params['ids']);
            //Временно
            set_time_limit(2000);
            $tdata = [
                'css' => $params['PDFTemplate'],
                'body' => ''
            ];

            foreach ($ids as $id) {

                $this->_obj->setId($id);
                $this->_obj->loadData($this->_fieldset->getKeys());

                if (isset($params['printFunc'])) {
                    $html = call_user_func([$this, 'proceed' . $_REQUEST['printFunc']], $params);
                } else {
                    $html = $this->proceedPrint($params);
                }

                $tdata['body'] .= '<div class="page-break">' . $html . '</div>';

                $pdfHtml = Template::parseTpl(
                    $this->_globalTemplate,
                    [
                        'body' => $html,
                        'css' => $params['PDFTemplate']
                    ]
                );
                $this->proceedSavePDF($pdfHtml, $this->getPDFParams($params));
            }

            $finalHtml = Template::parseTpl($this->_globalTemplate, $tdata);
            print $finalHtml;

            ApplicationAbstract::terminate();
        }
    }


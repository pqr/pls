    protected function massactionDelete($checkedIds)
    {
        $msgBuff = new Msg();
        $deleted = 0;
        foreach ($checkedIds as $id) {

            //Проверим, что id числовой и больше 0
            $idInt = (int)$id;
            if ($idInt <= 0) {
                continue;
            }

            //Проверим существование объекта в базе, попробовав его загрузить
            $obj = clone $this->_obj;
            $obj->setId($idInt);
            if (!$obj->loadData()) {
                $msgBuff->addError('Object with ID = ' . $idInt . ' not found');
                continue;
            }

            //Проверим, что у пользователя есть права доступа к этому объекту
            if (!$this->hasAccessRightToObj($obj) || !$this->hasWriteAccessRightToObj($obj)) {
                $msgBuff->addError('No access to delete object with ID = ' . $obj->getId());
                continue;
            }

            if ($this->_folders) {
                $this->deleteFolder($obj->getData());
            }
            $obj->deleteDb('Multiple Delete');
        }

        //Стандартное сообщение о числе обновлённых записей (зелёное или серое)
        $msg = 'Deleted: ' . $deleted;
        if ($deleted > 0) {
            $msgBuff->addSuccess($msg);
        } else {
            $msgBuff->addInfo($msg);
        }

        $this->sendMassactionSuccessDialog('Multiple Delete', $msgBuff->getHtml());
    }

    /**
     * Метод для переопределения в классах потоках - здесь проверяются права доступа к объекту в режимах View/Edit/Log/Delete
     */
    protected function hasAccessRightToObj(Obj $obj)
    {
        return true;
    }

    final protected function getBeautyMassactionErrorsList($errors)
    {
        if (count($errors) > 1) {
            return '<ol><li>' . implode('</li><li>', $errors) . '</li></ol>';
        } else {
            return $errors[0];
        }
    }

    private function ajaxTableReloadAction()
    {
        $this->_state = self::STATE_LIST;

        $this->initFieldsFromSubtables();
        $this->initList();
        $this->initPaginatable();
        $this->initSortable();
        $this->initLayoutable();

        $this->proceedFilters();
        $this->tableLoadData();

        $outHtml = $this->getHtmlTableForAjax();
        return $outHtml;
    }

    protected function initFieldsFromSubtables()
    {
        foreach ($this->_subtables as $subtableName => $subtableParams) {
            $subtableObj = $this->getSubtableObject($subtableName);
            //Добавим новые поля в $this->_fieldset
            //Эти поля объявлены внутри подтаблиц с переменных $this->_groupconcatFieldKeys и $this->_cacheFieldsKeys
            $subtableFields = $subtableObj->getFieldsForMasterModuleList();
            if ($subtableFields) {
                $this->_fieldset->addFields($subtableFields);
            }
        }
    }

    /**
     * Подготовительные работы для режима List
     * Добавлят дополнительные поля в начало и конец таблицы - чекбокс, инконки Color, Edit и Delete
     * Устанавливает страницу $this->setTablePage() в зависимости от текущей сесии и _findid
     * @return void
     */
    protected function initList()
    {
        //Параметр из класса Table: имя модуля на который автоматически делать ссылки в таблице
        $this->_tableLinkModule = Request::getModule();

        //Регистрируем массовые действия - метод initMassactionOptions должен быть переопределён в классе потомке
        $this->initMassactionOptions();
        //Добавляем опции печати
        $this->initPrintForms();
        $this->initMassactionOptionsFromPrintForms();

        //Регистрирует поля типа Folder, Checkbox, Del, ...
        $this->initTableFieldsAdditional();
    }

    /**
     * Метод для переопределения в классах потомках - здесь должен заполняться массив $this->_massactionOptions
     * Для более удобного заполнения массива _massactionOptions можно использовать метод $this->addMassactionOption()
     */
    protected function initMassactionOptions()
    {
    }

    /**
     * Регистрирует дополнительные поля для таблицы списка, такие как CheckBox, DEL ...
     * @return void
     */
    protected function initTableFieldsAdditional()
    {
        //Общие параметры для всех полей типов
        $commonParams['tableWidthHtml'] = 20;
        $commonParams['tableOrderBy'] = '';
        $commonParams['tableAlign'] = 'center';

        if ($this->_massactionOptions) {
            $params = $commonParams;
            $params['nameTable'] = '<input type="checkbox" class="cb-all">';
            $params['getHtmlFunction'] = function ($value, array $data) {
                if (isset($data['ID'])) {
                    return '<input type="checkbox" class="cb" value="' . $data['ID'] . '">';
                }

                return '';
            };
            $this->_fieldsetFirst->addField(F::create('CheckBox', F::TYPE_HTML, $params));
        }

        if ($this->_folders) {
            $this->addFolderField();
        }

        if (User::hasWriteAccess()) {

            if (isset($this->_fieldset['Color'])) {
                $this->_fieldset['Color']->setParam(
                    'source',
                    '?a=' . Request::getModule() . '&id={id}&func=changeField'
                );
                $this->_fieldsetFirst->addField($this->_fieldset['Color']);
            }

            if ($this->_allowDelete || $this->_allowEdit) {
                //Ширина колонки Del зависит от наличия иконки удаления
                $params = $commonParams;
                if ($this->_allowDelete && $this->_allowEdit) {
                    $params['tableWidthHtml'] = 40;
                } else {
                    $params['tableWidthHtml'] = 20;
                }
                $params['nameTable'] = '';
                $params['getHtmlFunction'] = function ($value, array $data) {

                    $outHtml = '';
                    if (isset($data['ID'])) {
                        if ($this->_allowEdit) {
                            $outHtml .= Link::moduleEdit(
                                Img::sprite('edit', 'Edit'),
                                $data['ID'],
                                $this->getTableRowLinkUrlParams($data, 0) + $this->getModuleSessionUrlParams()
                            );
                        }
                        if ($this->_allowDelete) {
                            $outHtml .= '<a href="#" class="del-link" title="Delete">' . Img::sprite('del') . '</a>';
                        }
                    }

                    return $outHtml;
                };

                $this->_fieldsetLast->addField(F::create('Actions', F::TYPE_HTML, $params));
            }
        }
    }

    protected function tableLoadData()
    {
        //Сделаем некую оптимизацию: сначала вынем все ID записей, которые должны в итоге попасть в таблицу
        //После этого достанем все поля, указав в условии WHERE ID IN (...)
        //Это значительно ускорит запрос, т.к. сортировка сначала LIMIT будут производиться на лёгком наборе ID
        //При выборке остальных колонок объём данных будет уже меньше за счёт ограниченного набора WHERE ID IN (...)

        $queryIds = "SELECT";

        //В режиме выгрузки таблицы в Excel нам не важно сколько строк в таблице всего
        if (!$this->isStateListExcel()) {
            $queryIds .= " SQL_CALC_FOUND_ROWS";
        }

        $queryIds .= " ID";

        //Проверим поле по которому идёт сортировка. Если оно вычисляемое, его тоже придётся добавить в этот запрос
        //Причём у этого вычисляемого поля могут быть зависимости, поэтому используем $this->_fieldset->getSqlSelect()
        $sortField = $this->getSortField();
        if ($sortField && $sortField->getParam('sqlSelect')) {
            $queryIds .= ', ' . $this->_fieldset->getSqlSelect([$sortField->key]);
        }

        $queryIds .= " FROM " . Db::quote($this->getDbTable());

        $sqlWhere = $this->getFiltersSqlWhere();
        if ($sqlWhere) {
            $queryIds .= " WHERE " . $sqlWhere;
        }

        //Cформируем условие сортировки.
        //Оно может состоять из сортировки указанной в trait TableSortable и из _tableDefaultOrderBy
        //Сначала соберём всё в массив, потом из него склеим строку
        $sqlOrderBy = [];
        if ($sortField) {
            $sqlOrderBy[] = $sortField->getParam('tableOrderBy') . ' ' . $this->getSortOrder();
        }

        if ($this->_tableDefaultOrderBy) {
            $sqlOrderBy[] = $this->_tableDefaultOrderBy;
        }

        $sqlOrderBy = implode(', ', $sqlOrderBy);

        if ($sqlOrderBy) {
            $queryIds .= " ORDER BY " . $sqlOrderBy;
        }

        if ($this->isStateListExcel()) {
            $queryIds .= ' LIMIT ' . $this->getTableExcelMaxRows();
        } elseif ($this->_tablePaginationEnabled) {
            $page = $this->getTablePage();
            $rowsPerPage = $this->getTableRowsPerPage();
            $queryIds .= ' LIMIT ' . ($page - 1) * $rowsPerPage . ', ' . $rowsPerPage;
        }

        //Получим все ID из базы
        $timer = new Timer();
        $ids = Db::getCol($queryIds);
        $this->_queryTime += $timer->get();

        if ($ids) {

            //Сразу посчитаем общее количество строк, если это не режим экспорта в Excel
            if (!$this->isStateListExcel()) {
                $foundRows = Db::getOne("SELECT FOUND_ROWS()");
                $this->setTableTotalRecordsFound($foundRows);
            }

            $idsString = implode(',', $ids);

            //Если это не режим экспорта в Excel, запишем ID всех отображенных пользователю строк в базу
            //Они понадобятся для навигации по стрелочкам в режимах View/Edit/Log
            if (!$this->isStateListExcel()) {
                $this->createModuleSession($idsString, $this->getTablePage());
            }

            //Теперь сделаем второй запрос, в котором WHERE ID IN (...) - результат запишем в таблицу $this->_tableData
            $query = "SELECT ";

            $selectFieldKeys = $this->getFieldsetShowed()->getKeys();
            $query .= $this->_fieldset->getSqlSelect($selectFieldKeys);

            $query .= " FROM " . Db::quote($this->getDbTable());
            $query .= " WHERE ID IN (" . $idsString . ")";

            if ($sqlOrderBy) {
                $query .= " ORDER BY " . $sqlOrderBy;
            }

            $timer = new Timer();
            $this->_tableData = Db::getAll($query);
            $this->_queryTime += $timer->get();
        }
    }

    final protected function isStateListExcel()
    {
        return $this->_state == self::STATE_LIST_EXCEL;
    }

    public function getHtmlTableForAjax($printHeadBlock = true, $printIfEmpty = false)
    {
        $outHtml = parent::getHtmlTableForAjax($printHeadBlock, $printIfEmpty);
        if ($this->hasFilters()) {
            $outHtml .= $this->getFiltersHiddenInput();
        }

        if ($this->_massactionOptions && $this->getTableDataCount() > 0) {
            $tdata = [
                'massactionsSelect' => F::create(
                        'massaction-select',
                        F::TYPE_SELECT,
                        ['options' => $this->_massactionOptions]
                    )->getHtmlInput('')
            ];

            $outHtml .= Template::parseTpl('module/listmassaction.tpl.php', $tdata);
        }

        return $outHtml;
    }

    /**
     * Метод вызывается через POST ajax запросы на url типа ?a=module&id=123&func=changeField
     */
    private function proceedChangeField()
    {
        $this->_state = self::STATE_VIEW_CHANGE_FIELD;

        if (!$this->_allowEdit || !User::hasWriteAccess() || !$this->hasWriteAccessRightToObj()) {
            Response::abort(403, 'Edit not allowed');
        }

        $fieldKey = $_POST['fieldKey'];
        $field = $this->_obj->getFieldset()->getField($fieldKey);
        if (!$field) {
            Response::abort(400, 'Field ' . $fieldKey . ' not found');
        }

        if (!$field->hasMode(F::MODE_SUBMIT)) {
            Response::abort(403, 'Field ' . $fieldKey . ' not editable');
        }

        $value = $_POST['value'];
        $data = [$fieldKey => $value];
        $normilizedValue = $field->getDataFromRequest($data);
        if ($normilizedValue === null) {
            Response::abort(400, 'Invalid value ' . $value);
        }

        $this->_obj->updateDb([$fieldKey => $normilizedValue]);
        //Возвращаем текст с новым значением
        print $this->_obj[$fieldKey];
        ApplicationAbstract::terminate();
    }

    /**
     * Метод для переопределения в классах потоках - здесь проверяются права доступа к объекту в режиме Edit
     */
    protected function hasWriteAccessRightToObj()
    {
        return true;
    }

    private function massactionMultipleUpdate($checkedIds)
    {
        //Функция getHtmlMultipleUpdateForm может быть переопределена в классе потомке - именно она формирует HTML код формы
        $bodyHtml = '<form action="?a=' . Request::getModule() . '&p=MultipleUpdateSubmit" method="post" class="multipleupdate">
                     <input type="hidden" name="CheckedIds" value="' . implode(',', $checkedIds) . '">
                     ' . $this->getHtmlMultipleUpdateFormBody() . '
                     </form>';
        Response::sendAjaxDialog(
            'Multiple Update (' . count($checkedIds) . ')',
            $bodyHtml,
            'Multiple Update (' . count($checkedIds) . ')',
            'Updating...'
        );
    }

    /**
     * Метод для переопределения в классах потомках
     * Иногда к полям выводимым для редакитирования на форме Multiple Update нужно добавить какие-то особенные поля
     * Например, поля связанные с подтаблицами
     * @return Fieldset
     */
    protected function getMultipleUpdateFieldset()
    {
        return $this->_fieldset->filterByMode(F::MODE_MULTIPLEUPDATE);
    }

    /**
     * Метод для переопределения в классах потомках, если нужно добавить какие-то переменные к шаблону
     * @return array
     */
    protected function getTplDataMultipleUpdateFormBody()
    {
        return $this->getMultipleUpdateFieldset()->getTplData([], F::MODE_MULTIPLEUPDATE);
    }

    /**
     * Для переопределения в классах потомках - возвращает HTML код формы БЕЗ ТЕГОВ form
     * @return string HTML
     */
    protected function getHtmlMultipleUpdateFormBody()
    {
        $tdata = $this->getTplDataMultipleUpdateFormBody();

        //Определим шаблон, который использовать для формы MultipleUpdate
        $module = Request::getModule();
        $templateFile = $module . 'MultipleUpdate.tpl.php';
        if (!Template::findfile($templateFile)) {
            $templateFile = 'module/multipleupdate/auto.tpl.php';
        }

        return Template::parseTpl($templateFile, $tdata);
    }

    protected function massactionPrintForm($checkedIds, $printForm)
    {
        $additionalCssFile = $this->_printForms[$printForm]['additionalCssFile'];

        $bodyHtml = '';
        foreach ($checkedIds as $id) {

            $obj = clone $this->_obj;
            $obj->setId($id);
            $obj->loadData();
            $currentBodyHtml = $this->getPrintFormBodyHtml($obj, $printForm);

            //Если у этой печатной пормы стоял флаг savePdfIntoFolder, то нужно сохранить и PDF вариант в папку
            if ($this->_printForms[$printForm]['savePdfIntoFolder']) {
                $currentTitle = $this->getPrintFormTitle($obj);
                $currentFullHtml = $this->getPrintFormFullHtml($currentTitle, $additionalCssFile, $currentBodyHtml);
                $this->savePrintFormPdfInFilesFolder($currentFullHtml, $obj, $printForm);
            }

            $bodyHtml .= '<div style="page-break-after: always"></div>' . $currentBodyHtml;
        }

        //Оборачиваем в мастер-шаблон для печати и выводим на экран
        $title = $this->_printForms['massactionTitle'] ? : $this->_printForms['text'];
        print $this->getPrintFormFullHtml($title, $additionalCssFile, $bodyHtml);

        ApplicationAbstract::terminate();
    }

    /**
     * Метод для переорпделения в классах потомках. Здесь нужно последовательно вызывать $this->addPrintForm()
     * для добавления новых печатных форм
     */
    protected function initPrintForms()
    {
    }

    /**
     * Этот метод вызывается автоматически, чтобы перенести печатные формы в выпадющий список massaction
     */
    private function initMassactionOptionsFromPrintForms()
    {
        foreach ($this->_printForms as $printForm => $params) {
            $this->addMassactionOption('PrintForm' . $printForm, $params['text'], '', 'Print', true);
        }
    }

    /**
     * @param string $printForm условоное имя печатной формы
     * @param string $text текст отображаемый на пользовательском интерфейсе
     * @param string|null $massactionTitle при печати через massaction много документов склеиваются в один, что выводит
     * в title html документа? Здесь можно задать какой-то фиксированный заголовк. Если этот параметр не передан, то
     * используется предыдущий параметр $text, как заголовок
     * @param string|null $bodyTemplate имя файла шаблона, если нужен какой-то особый файл. По умолчанию используется файл
     * с именем печатной формы из папки PrintForms внутри папки текущего модуля
     * @param string|null $additionalCssFile
     * @param bool $savePdfIntoFolder сохранять ли pdf копию в папку?
     * @param string|null $pdfFilenameSuffix
     */
    final protected function addPrintForm(
        $printForm,
        $text,
        $massactionTitle = null,
        $bodyTemplate = null,
        $additionalCssFile = null,
        $savePdfIntoFolder = false,
        $pdfFilenameSuffix = null
    ) {
        $this->_printForms[$printForm] = [
            'text' => $text,
            'massactionTitle' => $massactionTitle,
            'bodyTemplate' => $bodyTemplate,
            'additionalCssFile' => $additionalCssFile,
            'savePdfIntoFolder' => $savePdfIntoFolder,
            'pdfFilenameSuffix' => $pdfFilenameSuffix
        ];
    }

    /**
     * Возвращает имя файла шаблона для указанной печатной формы. По умолчанию имя файла шаблона совпадает с условным
     * именем печатной формы: происходит автоматический поиск в папке PrintForms внутри текущей папки
     * Однако можно указать какой-то не стандартный шаблон, когда печатная форму регистрируется с помощью $this->addPrintForm()
     * @param string $printForm условоное имя печатной формы
     * @return string
     */
    protected function getPrintFormBodyTemplate($printForm)
    {
        $bodyTemplate = $this->_printForms[$printForm]['bodyTemplate'];
        if (!$bodyTemplate) {
            //Для данной печатной формы какой-то осбый шаблон не определён - используем стандартный из папки PrtinForms
            $bodyTemplate = $printForm . '.tpl.php';
        }

        return $bodyTemplate;
    }

    /**
     * Возвращает данные для файла-шаблона печати
     * Этот метод можно переопределить в классах потомках, если нужно добавить больше переменных для текущего шаблона печати
     * Например, если нужно добавить переменные содержащие подтаблицы
     * @param \Light\Obj $obj
     * @param string $printForm условоное имя печатной формы
     * @return array
     */
    protected function getPrintFormTplData(Obj $obj, $printForm)
    {
        $tdata = $obj->getTplData(F::MODE_VIEW);
        $tdata['_printForm'] = $printForm;
        return $tdata;
    }

    /**
     * Возвращает HTML код печатной формы для переданного объекта. Используется как из режима view, так и из режима massaction
     * @param Obj $obj
     * @param string $printForm условоное имя печатной формы
     * @return string HTML код документа
     */
    protected function getPrintFormBodyHtml(Obj $obj, $printForm)
    {
        //Обычно печать происходит с помощью подготовленного шаблона из папки PrintForm
        $template = 'PrintForms/' . $this->getPrintFormBodyTemplate($printForm);
        $tdata = $this->getPrintFormTplData($obj, $printForm);
        return Template::parseTpl($template, $tdata);
    }

    /**
     * Возвращает title для HTML документа при печати из режима View и для pdf файла при массвой печати из massaction
     * @param Obj $obj
     * @return string
     */
    protected function getPrintFormTitle(Obj $obj)
    {
        return $this->_textObjectName . ' ' . strip_tags($obj->getDescriptionHtml());
    }

    protected function getPrintFormFullHtml($title, $additionalCssFile, $bodyHtml)
    {
        $tdata = ['title' => $title, 'additionalCssFile' => $additionalCssFile, 'body' => $bodyHtml];
        return Template::parseTpl('module/PrintFormsMaster.tpl.php', $tdata);
    }

    protected function getPrintFormPdfFilename(Obj $obj, $printForm)
    {
        $filename = $this->_textObjectName . ' ' . strip_tags($obj->getDescriptionHtml());
        if ($this->_printForms[$printForm]['pdfFilenameSuffix']) {
            $filename .= ' ' . $this->_printForms[$printForm]['pdfFilenameSuffix'];
        }
        $filename .= '.pdf';

        return $filename;
    }

    /**
     * Вызывается из метода proceedViewPrintFrom(), когда пользователь печатает документ из режима View
     * и из massactionPrintForm(), когда пользователь печатает через massaction
     * @param string $fullHtml полный HTML код документа, готовый к конвертации в pdf
     * @param Obj $obj объект для которого печатается форма (нужен для формирования имени pdf файла)
     * @param string $printForm выбранная пользователем печатная форма (нужно для определения суффикса в имени pdf файла)
     */
    protected function savePrintFormPdfInFilesFolder($fullHtml, Obj $obj, $printForm)
    {
        $filename = $this->getPrintFormPdfFilename($obj, $printForm);
        $filepath = $this->getFolderRelativePath($obj->getData()) . '/' . $filename;
        Pdf::saveIntoFilesFolder($fullHtml, $filepath);
    }
}

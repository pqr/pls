    {
        return '';
    }

    public function getPDFParams($params = [])
    {
        if ($params['Module'] == null || $params['ObjectID'] == null || $params['ObjectName'] == null) {
            $defaultParams = [
                'Module' => $this->getTableName(),
                'ObjectID' => $this->_obj->getId(),
                'ObjectName' => $this->_textObjectName
            ];

            $params = array_merge($params, $defaultParams);
        }

        return $params;
    }

    /**
     * @param $html
     * @param array $params
     * @param bool $refresh пока всегда true
     */
    public function proceedSavePDF($html, array $params, $refresh = false)
    {
        /*
        if ($this->_justInserted) {
            $refresh = true;
        }
        File::saveDocumentPDFIntoShareFolder($html, $params, $refresh);
        */

        $filename = $this->_textObjectName . ' ' . $this->_obj->getId();

        if ($params['Lang'] !== null) {
            $filename .= '  ' . $params['Lang'];
        }

        if ($params['Stamp']) {
            $filename .= ' With Stamp';
        }

        $filename .= '.pdf';

        $destPath = $this->getFolderRelativePath($this->_obj->getData()) . '/' . $filename;
        Pdf::saveIntoFilesFolder($html, $destPath);
    }


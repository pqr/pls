{
  "compilerOptions": {
    "target": "es5",
    "noImplicitAny": true,
    "noImplicitThis": true,
    "removeComments": false,
    "preserveConstEnums": true,
    "sourceMap": true,
    "experimentalDecorators": false,
    "listFiles": true,
    "listEmittedFiles": true,
    "pretty": true,
    "allowJs": false,
    "strictNullChecks": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "newLine": "LF",
    "declaration": true,
    "outDir": "types",
    "lib": [
      "dom",
      "es2017"
    ]
  },
  "exclude": ["types"]
}

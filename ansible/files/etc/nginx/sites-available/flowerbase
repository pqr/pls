server {
    listen 80;
    listen [::]:80;
    server_name 2.forwardlog.net;

    sendfile on;
    tcp_nopush on;
    client_max_body_size 0;
    client_header_buffer_size 1k;
    large_client_header_buffers 4 8k;

    keepalive_timeout 65;
    types_hash_max_size 2048;

    gzip_min_length 1100;
    gzip_types text/plain text/css application/json text/xml application/xml application/xml+rss text/javascript;

	root {{ project_dir_flowerbase }}/public;
	index index.php index.html index.htm;

    access_log off;
    log_not_found off;

	location / {
        try_files $uri $uri/ =404;
        add_header  X-Robots-Tag "noindex, nofollow, nosnippet, noarchive";
    }

    location ~ \.php$ {
        fastcgi_read_timeout 700s;
        fastcgi_send_timeout 700s;
        fastcgi_buffers 8 32k;
        fastcgi_buffer_size 32k;

        fastcgi_pass unix:/run/php/php{{ php_version }}-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $request_filename;
        include fastcgi_params;

        add_header  X-Robots-Tag "noindex, nofollow, nosnippet, noarchive";
    }

    location ~ /\.git {
        deny all;
    }

    location ~ \.(js|css)$ {
         expires max;
    }
}

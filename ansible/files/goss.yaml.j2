file:
  /etc/php/{{ php_version }}/fpm/php-fpm.conf:
    exists: true
    filetype: file
    contains: []
  /etc/php/{{ php_version }}/fpm/pool.d/www.conf:
    exists: true
    filetype: file
    contains: []
port:
  tcp:80:
    listening: true
    ip:
    - 0.0.0.0
service:
  nginx:
    enabled: true
    running: true
  php{{ php_version }}-fpm:
    enabled: true
    running: true
user:
  www-data:
    exists: true
group:
  www-data:
    exists: true
command:
  php -m:
    exit-status: 0
    stdout: []
    stderr:
    - '!/./'
    timeout: 0
  php -m | grep -i curl:
    exit-status: 0
    stdout: []
    stderr: []
    timeout: 0
  php -m | grep -i date:
    exit-status: 0
    stdout: []
    stderr: []
    timeout: 0
  php -m | grep -i dom:
    exit-status: 0
    stdout: []
    stderr: []
    timeout: 0
  php -m | grep -i exif:
    exit-status: 0
    stdout: []
    stderr: []
    timeout: 0
  php -m | grep -i gd:

    - '!/./'
    timeout: 0
  php-fpm{{ php_version }} -m:
    exit-status: 0
    stdout: []
    stderr:
    - '!/./'
    timeout: 0
  php-fpm{{ php_version }} -m | grep -i cgi-fcgi:
    exit-status: 0
    stdout: []
    stderr: []
    timeout: 0
  php-fpm{{ php_version }} -v:
    exit-status: 0
    stdout:
    - PHP {{ php_version }}
    stderr:
    - '!/./'
    timeout: 0

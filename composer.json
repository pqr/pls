{
  "config" : {
    "optimize-autoloader": true,
    "platform": {
      "php": "7.3"
    }
  },
  "require": {
    "php": "7.3.*",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "ext-mysqli": "*",
    "ext-json": "*",
    "ext-imap": "*",
    "ext-readline": "*",
    "ext-simplexml": "*",
    "ext-xml": "*",
    "ext-xsl": "*",
    "ext-zip": "*",
    "swiftmailer/swiftmailer": "@stable",
    "tedivm/fetch": "@stable",
    "symfony/dom-crawler": "@stable",
    "symfony/css-selector": "@stable",
    "nesbot/carbon": "@stable",
    "mtdowling/cron-expression": "@stable",
    "guzzlehttp/guzzle": "@stable",
    "studio-42/elfinder": "@stable",
    "sentry/sdk": "^2.0",
    "phpoffice/phpspreadsheet": "^1.0",
    "symfony/process": "^4.2",
    "symfony/filesystem": "^4.2",
    "mpdf/mpdf": "dev-test",
    "league/csv": "^9.1",
    "nyholm/psr7": "^1.2",
    "nyholm/psr7-server": "^0.4.1",
    "laminas/laminas-httphandlerrunner": "^1.1"
  },
  "require-dev": {
    "codeception/codeception": "^4.0",
    "codeception/module-phpbrowser": "^1.0.0",
    "codeception/module-rest": "^1.0.0",
    "codeception/module-asserts": "^1.0.0",
    "phpunit/phpunit": "^8"
  },
  "autoload": {
    "psr-4": {
      "Forward\\": "src/Forward/",
      "Light\\": "src/Light/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\Forward\\": "tests/unit/Forward/"
    }
  },
  "scripts": {
    "test": [
      "vendor/bin/codecept run functional --skip-group pdf"
    ]
  }
}

{
  "config" : {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3"
    },
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "require": {
    "php": "8.3.*",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "ext-mysqli": "*",
    "ext-json": "*",
    "ext-imap": "*",
    "ext-readline": "*",
    "ext-simplexml": "*",
    "ext-xml": "*",
    "ext-xsl": "*",
    "ext-zip": "*",
    "swiftmailer/swiftmailer": "@stable",
    "nesbot/carbon": "@stable",
    "guzzlehttp/guzzle": "@stable",
    "studio-42/elfinder": "@stable",
    "sentry/sdk": "^4.0",
    "phpoffice/phpspreadsheet": "^1.0",
    "symfony/process": "^7.0",
    "symfony/filesystem": "v7.0.6",
    "mpdf/mpdf": "@stable",
    "league/csv": "^9.1",
    "nyholm/psr7": "^1.8.1",
    "nyholm/psr7-server": "^1.1.0",
    "laminas/laminas-httphandlerrunner": "^2.10.0",
    "psr/http-factory": "@stable"
  },
  "require-dev": {
    "rector/rector": "^1.0",
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-deprecation-rules": "^1.1",
    "phpstan/phpstan-strict-rules": "^1.5"
  },
  "autoload": {
    "psr-4": {
      "Forward\\": "src/Forward/",
      "Light\\": "src/Light/"
    }
  },
  "autoload-dev": {
    "psr-4": {
    }
  },
  "scripts": {
    "test": [
    ]
  }
}
